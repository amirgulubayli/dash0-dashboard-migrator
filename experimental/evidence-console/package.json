{
  "name": "dd2dash0-evidence-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only evidence screen for a dd2dash0 run: reads report.json and events.jsonl, nothing else.",
  "scripts": {
    "build": "vite build",
    "serve": "tsx server/main.ts",
    "start": "npm run build && tsx server/main.ts",
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc -p . --noEmit",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.50.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
