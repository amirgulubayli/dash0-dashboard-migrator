{
  "name": "dash0-dashboard-migrator",
  "version": "0.1.0",
  "description": "Deterministic Datadog -> Dash0 migrator: dashboards to Perses, queries to PromQL, monitors to Dash0 check rules.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "dd2dash0": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p . --noEmit",
    "improve": "tsx tools/improve/main.ts",
    "typecheck:tools": "tsc -p tools"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@types/node": "^22.10.0",
    "fast-check": "^3.23.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@elevenlabs/client": "1.30.0",
    "@lezer/lr": "^1.4.12",
    "@prometheus-io/lezer-promql": "^0.316.0",
    "yaml": "^2.6.1"
  }
}
