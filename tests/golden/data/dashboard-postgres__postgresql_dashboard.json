    "kind": "panel",
    "title": "System memory",
    "widget_type": "timeseries",
    "status": "exact-under",
    "promql": [
      "sum (avg_over_time({otel_metric_name=\"system.mem.usable\"}[$__interval]))",
      "sum (avg_over_time({otel_metric_name=\"system.mem.total\"}[$__interval])) - sum (avg_over_time({otel_metric_name=\"system.mem.usable\"}[$__interval]))"
    ],
    "rules": [
